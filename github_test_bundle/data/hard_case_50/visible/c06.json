{
  "case": "c06",
  "brief": "You are acting for outgoing workshop steward Ada. Complete the seven operational handover commissions in delegation/ada. Keep the workshop running, preserve authorship credit, and hand over actual jobs and copies. All people and permissions in this world are fictional.",
  "clock": 0,
  "horizon": 160,
  "done": false,
  "protocol": {
    "schema": "coupled10-api-v1",
    "operations": {
      "READ": {
        "ids": "nonempty list of available IDs"
      },
      "SEARCH": {
        "query": "string"
      },
      "EDIT_PROJECT": {
        "project": "project ID",
        "content": "JSON object"
      },
      "PATCH_PROJECT": {
        "project": "project ID",
        "patch": "JSON object"
      },
      "RESERVE": {
        "worker": "worker ID",
        "project": "project ID",
        "dependencies": "optional job/file IDs",
        "content": "optional JSON object",
        "kind": "optional output kind",
        "purpose": "optional string",
        "sources": "optional source IDs"
      },
      "CANCEL_JOB": {
        "job": "job ID"
      },
      "PRIVATE_REQUEST": {
        "request": "request catalog ID",
        "text": "actual private request"
      },
      "REQUEST_REVIEW": {
        "files": "completed file IDs",
        "claims": "optional JSON object"
      },
      "PUT_OBJECT": {
        "id": "new object ID",
        "kind": "string",
        "content": "JSON object",
        "platform": "optional platform ID",
        "files": "optional file IDs",
        "review": "optional approved review ID",
        "publish_at": "required future integer minute for kind=schedule"
      },
      "UPDATE_OBJECT": {
        "id": "object ID",
        "content": "optional JSON object",
        "files": "optional file IDs",
        "review": "optional review ID",
        "publish_at": "optional future integer minute"
      },
      "CANCEL_OBJECT": {
        "id": "object ID"
      },
      "VERIFY": {
        "id": "processed object ID"
      },
      "SEND": {
        "to": "recipient string",
        "text": "actual private message",
        "files": "optional completed file IDs",
        "object": "optional object ID"
      },
      "NOTE": {
        "text": "string"
      },
      "WAIT": {
        "until": "optional future integer minute <=horizon; otherwise next event"
      },
      "FINISH": {
        "text": "final handoff"
      }
    },
    "time": "Ordinary actions advance 1 minute, fire due events, then commit. Rejected actions cost 1 minute. WAIT jumps to next event/start/completion or explicit until. FINISH does not drain pending work. Actions commit at horizon, then close.",
    "job_statuses": [
      "queued",
      "running",
      "discarding",
      "completed",
      "cancelled"
    ],
    "object_statuses": [
      "processing",
      "ready",
      "scheduled",
      "published",
      "cancelled"
    ],
    "request_outcomes": [
      "accepted",
      "declined",
      "no_reply"
    ],
    "review": {
      "delay": 1,
      "requires": []
    },
    "artifact_format": {
      "content": {
        "document": "reservation document snapshot",
        "inputs": "immutable input artifact snapshots at start",
        "sources": "declared source IDs",
        "purpose": "declared purpose"
      }
    },
    "semantics": "All actual arbitrary content is accepted subject to physical/API checks. Tool success is not semantic/rubric success."
